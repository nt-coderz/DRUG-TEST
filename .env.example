# GEMINI_API_KEY: Required for Gemini AI API calls (Chatbot, Search Grounding, Maps Grounding).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key for interactive vector map tiles.
# Configure via Project Settings -> Secrets in Google AI Studio.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
